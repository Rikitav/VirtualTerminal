<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vt="clr-namespace:VirtualTerminal;assembly=VirtualTerminal.Avalonia"
        xmlns:controls="clr-namespace:VirtualTerminal.Controls;assembly=VirtualTerminal.Avalonia"
        mc:Ignorable="d"
        x:Class="VirtualTerminal.AvaloniaTestApp.MainWindow"
        Title="VirtualTerminal Avalonia - Multiplexer &amp; Terminal Demo"
        Width="950"
        Height="650">
  <TabControl Background="#1E1E1E">
    <TabItem Header="Multiplexer Workspace (Demo)">
      <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0" Background="#2D2D30" Padding="8,5" BorderBrush="#3F3F46" BorderThickness="0,0,0,1">
          <DockPanel LastChildFill="False">
            <TextBlock Text="Multiplexer Workspace" Foreground="#FFFFFF" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0"/>
            <Button Content="+ New Tab" Padding="8,3" Margin="0,0,6,0" Click="Button_NewTab_Click"/>
            <Button Content="Split Vertical (│)" Padding="8,3" Margin="0,0,6,0" Click="Button_SplitVertical_Click"/>
            <Button Content="Split Horizontal (─)" Padding="8,3" Margin="0,0,6,0" Click="Button_SplitHorizontal_Click"/>
            <Button Content="Close Active Pane (✕)" Padding="8,3" Margin="0,0,10,0" Click="Button_ClosePane_Click"/>
            <Button Content="+ TUI Menu Pane" Padding="8,3" Margin="0,0,6,0" Click="Button_LaunchTui_Click"/>
            <TextBlock Text="• Drag splitters to resize • Use top-right action buttons (│, ─, ✕)" Foreground="#888888" VerticalAlignment="Center" Margin="10,0,0,0"/>
          </DockPanel>
        </Border>

        <controls:TerminalMultiplexerControl x:Name="PART_Multiplexer" Grid.Row="1"/>
      </Grid>
    </TabItem>

    <TabItem Header="Single Terminal (Classic)">
      <Grid RowDefinitions="40,*,30">
        <Border Grid.Row="0"
                BorderBrush="Gray"
                BorderThickness="1"
                CornerRadius="5"
                Margin="5">
          <DockPanel>
            <TextBlock Text="CMD : "
                       VerticalAlignment="Center"
                       Margin="5,0,0,0" />

            <Button DockPanel.Dock="Right"
                    Content="Invalidate"
                    Click="Button_Click_Invalidate" />

            <Button DockPanel.Dock="Right"
                    Content="Start"
                    Click="Button_Click_Start" />

            <TextBox x:Name="PART_CommandLineName"
                     VerticalContentAlignment="Center"
                     HorizontalAlignment="Stretch"
                     VerticalAlignment="Stretch"
                     Text="powershell.exe" />
          </DockPanel>
        </Border>

        <vt:TerminalControl x:Name="PART_Terminal_Left"
                            Grid.Row="1"
                            AllowDirectInput="True"
                            CursorVisible="True"
                            Background="Black"
                            TerminalFontFamily="Cascadia Mono" />

        <vt:PromptBox x:Name="PART_Prompt_Left"
                      Grid.Row="2"
                      Prompt=">" />
      </Grid>
    </TabItem>
  </TabControl>
</Window>
