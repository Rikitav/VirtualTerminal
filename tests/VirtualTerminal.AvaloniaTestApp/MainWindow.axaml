<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vt="clr-namespace:VirtualTerminal;assembly=VirtualTerminal.Avalonia"
        xmlns:controls="clr-namespace:VirtualTerminal.Controls;assembly=VirtualTerminal.Avalonia"
        mc:Ignorable="d"
        x:Class="VirtualTerminal.AvaloniaTestApp.MainWindow"
        Title="VirtualTerminal Avalonia - Multiplexer &amp; Control Tiling Demo"
        Width="1000"
        Height="700">
  <Grid RowDefinitions="Auto,*">
    <!-- Multiplexer Actions Toolbar (bound to ICommand and public API) -->
    <Border Grid.Row="0" Background="#252526" Padding="10,6" BorderBrush="#3F3F46" BorderThickness="0,0,0,1">
      <DockPanel LastChildFill="False">
        <TextBlock Text="Multiplexer Manager:" Foreground="#FFFFFF" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>

        <!-- Command-bound action buttons -->
        <Button Content="Split Right" Command="{Binding #PART_Multiplexer.SplitVerticalCommand}" Padding="8,4" Margin="0,0,6,0"/>
        <Button Content="Split Down" Command="{Binding #PART_Multiplexer.SplitHorizontalCommand}" Padding="8,4" Margin="0,0,6,0"/>
        <Button Content="Close Active" Command="{Binding #PART_Multiplexer.CloseActiveCommand}" Padding="8,4" Margin="0,0,10,0"/>
        <Button Content="Next (→)" Command="{Binding #PART_Multiplexer.FocusNextCommand}" Padding="6,4" Margin="0,0,4,0"/>
        <Button Content="Prev (←)" Command="{Binding #PART_Multiplexer.FocusPreviousCommand}" Padding="6,4" Margin="0,0,10,0"/>

        <!-- Public API custom actions -->
        <Button Content="+ Generic Control" Click="Button_AddCustomControl_Click" Padding="8,4" Margin="0,0,6,0"/>
        <Button Content="+ TUI Terminal" Click="Button_AddTuiTerminal_Click" Padding="8,4" Margin="0,0,10,0"/>
        <Button Content="Save Layout" Click="Button_SaveLayout_Click" Padding="8,4" Margin="0,0,4,0"/>
        <Button Content="Restore Layout" Click="Button_RestoreLayout_Click" Padding="8,4" Margin="0,0,10,0"/>

        <TextBlock x:Name="PART_StatusText" Text="Panes: 1" Foreground="#AAAAAA" VerticalAlignment="Center" Margin="10,0,0,0"/>
      </DockPanel>
    </Border>

    <!-- The tab-free MultiplexerControl hosting the split tree -->
    <controls:MultiplexerControl x:Name="PART_Multiplexer" Grid.Row="1" Background="#1E1E1E"/>
  </Grid>
</Window>
