<Window x:Class="VirtualTerminal.TestApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VirtualTerminal.TestApp"
        xmlns:vt="clr-namespace:VirtualTerminal;assembly=VirtualTerminal.WPF"
        xmlns:controls="clr-namespace:VirtualTerminal.Controls;assembly=VirtualTerminal.WPF"
        mc:Ignorable="d"
        Title="VirtualTerminal WPF - Multiplexer &amp; Control Tiling Demo" Height="700" Width="1000">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Multiplexer Actions Toolbar (bound to ICommand and public API) -->
        <Border Grid.Row="0" Background="#252526" Padding="10,6" BorderBrush="#3F3F46" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False">
                <TextBlock Text="Multiplexer Manager:" Foreground="#FFFFFF" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>

                <!-- Command-bound action buttons -->
                <Button Content="Split Right (Ctrl+Shift+E)" Command="{Binding SplitVerticalCommand, ElementName=PART_Multiplexer}" Padding="8,4" Margin="0,0,6,0"/>
                <Button Content="Split Down (Ctrl+Shift+O)" Command="{Binding SplitHorizontalCommand, ElementName=PART_Multiplexer}" Padding="8,4" Margin="0,0,6,0"/>
                <Button Content="Close Active (Ctrl+Shift+W)" Command="{Binding CloseActiveCommand, ElementName=PART_Multiplexer}" Padding="8,4" Margin="0,0,10,0"/>
                <Button Content="Next (Alt+→)" Command="{Binding FocusNextCommand, ElementName=PART_Multiplexer}" Padding="6,4" Margin="0,0,4,0"/>
                <Button Content="Prev (Alt+←)" Command="{Binding FocusPreviousCommand, ElementName=PART_Multiplexer}" Padding="6,4" Margin="0,0,10,0"/>

                <!-- Public API custom actions -->
                <Button Content="+ Generic Control" Click="Button_AddCustomControl_Click" Padding="8,4" Margin="0,0,6,0" ToolTip="Split with a non-terminal WPF control"/>
                <Button Content="+ TUI Terminal" Click="Button_AddTuiTerminal_Click" Padding="8,4" Margin="0,0,10,0" ToolTip="Split with a TUI menu terminal"/>
                <Button Content="Save Layout" Click="Button_SaveLayout_Click" Padding="8,4" Margin="0,0,4,0"/>
                <Button Content="Restore Layout" Click="Button_RestoreLayout_Click" Padding="8,4" Margin="0,0,10,0"/>

                <TextBlock x:Name="PART_StatusText" Text="Panes: 1" Foreground="#AAAAAA" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </DockPanel>
        </Border>

        <!-- The tab-free MultiplexerControl hosting the split tree -->
        <controls:MultiplexerControl x:Name="PART_Multiplexer" Grid.Row="1" Background="#1E1E1E"/>
    </Grid>
</Window>
